<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:label="HackDiet Sync"
        android:icon="@drawable/ic_widget"
        android:theme="@style/Theme.HackDietWidget">

        <!-- Settings Activity -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="HackDiet Sync — Impostazioni">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Widget Provider -->
        <receiver
            android:name=".SyncWidget"
            android:exported="true"
            android:label="HackDiet Sync">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.hackdiet.widget.SYNC_ACTION" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <!-- Widget Provider 2×1 -->
        <receiver
            android:name=".SyncWidget2x1"
            android:exported="true"
            android:label="HackDiet Sync 2×1">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_2x1" />
        </receiver>

        <!-- WorkManager worker (implicit, no declaration needed) -->

    </application>
</manifest>
