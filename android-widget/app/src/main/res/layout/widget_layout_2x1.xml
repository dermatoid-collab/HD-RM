<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/widget_root"
    android:orientation="horizontal"
    android:background="@drawable/widget_bg">

    <!-- Striscia colorata sinistra -->
    <ImageView
        android:id="@+id/v_stripe"
        android:layout_width="5dp"
        android:layout_height="match_parent"
        android:background="#4ade80"
        android:contentDescription="@null" />

    <!-- Zona icone -->
    <LinearLayout
        android:layout_width="40dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <ImageView
            android:id="@+id/iv_upload"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_widget"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/iv_status_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="3dp"
            android:src="@drawable/ic_alarm"
            android:contentDescription="@null"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/tv_status_check"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="✓"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#4ade80"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Zona dati (righe centrate) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="2dp"
        android:paddingEnd="4dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/tv2_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HD-RM Sync"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:textColor="#64B5F6"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/tv2_datetime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--/-- · --:--"
            android:textSize="13sp"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:textColor="#ffffff"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/tv2_kcal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="— kcal"
            android:textSize="13sp"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:textColor="#ffffff"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/tv2_sleep"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="D—·R—"
            android:textSize="13sp"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:textColor="#ffffff"
            android:fontFamily="monospace" />

    </LinearLayout>

</LinearLayout>
