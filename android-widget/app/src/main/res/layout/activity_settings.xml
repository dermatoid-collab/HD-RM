<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Garmin Personal API Key"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/et_garmin_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="sk-…"
            android:inputType="textPassword"
            android:singleLine="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Intervals.icu API Key"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/et_intervals_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="API key"
            android:inputType="textPassword"
            android:singleLine="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Intervals.icu Athlete ID"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/et_athlete_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:hint="i12345"
            android:inputType="text"
            android:singleLine="true" />

        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Salva" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Formato sonno per Intervals.icu"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <RadioGroup
            android:id="@+id/rg_sleep_format"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">

            <RadioButton
                android:id="@+id/rb_hm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Testo: 1h1m  (campo text su Intervals)" />

            <RadioButton
                android:id="@+id/rb_min"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Minuti interi: 61" />

        </RadioGroup>

        <Button
            android:id="@+id/btn_read"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="🔍 Leggi dati da Garmin" />

        <Button
            android:id="@+id/btn_sync"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:text="▶ Sincronizza ora → Intervals" />

        <!-- ── Sfondo widget ── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sfondo widget"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- Palette colori -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp"
            android:gravity="start">

            <View android:id="@+id/swatch_black"
                android:layout_width="40dp" android:layout_height="40dp"
                android:layout_marginEnd="8dp" android:background="#000000" />
            <View android:id="@+id/swatch_darkgray"
                android:layout_width="40dp" android:layout_height="40dp"
                android:layout_marginEnd="8dp" android:background="#1C1C1E" />
            <View android:id="@+id/swatch_night"
                android:layout_width="40dp" android:layout_height="40dp"
                android:layout_marginEnd="8dp" android:background="#0D1B2A" />
            <View android:id="@+id/swatch_indigo"
                android:layout_width="40dp" android:layout_height="40dp"
                android:layout_marginEnd="8dp" android:background="#1A1A2E" />
            <View android:id="@+id/swatch_white"
                android:layout_width="40dp" android:layout_height="40dp"
                android:background="#FFFFFF" />

        </LinearLayout>

        <!-- Alpha seekbar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Opacità: "
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/sb_bg_alpha"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progress="75" />

            <TextView
                android:id="@+id/tv_bg_alpha"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:text="75%"
                android:textSize="13sp"
                android:gravity="end" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33FFFFFF"
            android:layout_marginBottom="24dp" />

        <!-- ── Backup ── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Backup impostazioni"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="32dp"
            android:weightSum="2">

            <Button
                android:id="@+id/btn_export"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="⬆ Esporta" />

            <Button
                android:id="@+id/btn_import"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="⬇ Importa" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Log sincronizzazioni"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tv_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:textIsSelectable="true"
            android:text="Nessuna sincronizzazione ancora." />

    </LinearLayout>
</ScrollView>
